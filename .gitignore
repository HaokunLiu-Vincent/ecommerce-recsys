# Local environments, Python bytecode, and development tool caches.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.pyright/
.mypy_cache/
.ipynb_checkpoints/

# Operating system metadata and temporary Office files.
.DS_Store
~$*

# Local configuration and secrets; keep the example environment file tracked.
.env
.env.*
!.env.example
kaggle.json
.aws/
*.pem
*.key

# Logs, temporary files, and local output directories.
*.log
*.tmp
outputs/
logs/

# Keep all source data and generated run artifacts under data/ untracked.
/data/**

# Embeddings, columnar tables, model weights, and vector indexes.
*.npy
*.npz
*.parquet
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.index

# Exclude data exports and serialized artifacts created outside data/ as well.
*.csv
*.tsv
*.jsonl
*.ndjson
*.arrow
*.ipc
*.feather
*.faiss
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.bin
*.zip
*.tar
*.tar.gz
*.tgz

# Catch misplaced runtime directories and model exports outside data/.
models/
checkpoints/
runs/
artifacts/
canonical/
processed/
text_features/
image_features/
embeddings/
lambdamart.txt
model.txt
mlruns/
wandb/

# Keep catalog images and exported notebook figures local.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tiff

# Exclude authentication files, private keys, and local credential stores.
.netrc
.ssh/
.kaggle/
.config/gcloud/
credentials*.json
service-account*.json
service_account*.json
client_secret*.json
kaggle*.json
id_rsa*
id_ed25519*
*.p12
*.pfx
.git-credentials
.config/gh/
.config/git/
tokens*.json
token*.json

# Local caches, coverage reports, and Python build artifacts.
.cache/
.uv/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Additional token and OAuth credential file formats.
token*.yaml
token*.yml
oauth*.json
oauth*.yaml
oauth*.yml

# Preserve historical references locally, outside the active codebase.
/docs/achive/